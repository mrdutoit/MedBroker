{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/auth/:slug*",         "destination": "/api/auth-router?slug=:slug*" },
    { "source": "/api/leads/:slug*",        "destination": "/api/leads-router?slug=:slug*" },
    { "source": "/api/users/:slug*",        "destination": "/api/users-router?slug=:slug*" },
    { "source": "/api/flags/:slug*",        "destination": "/api/flags-router?slug=:slug*" },
    { "source": "/api/appointments/:slug*", "destination": "/api/appointments-router?slug=:slug*" },
    { "source": "/api/reports/:slug*",      "destination": "/api/reports-router?slug=:slug*" },
    { "source": "/api/events/:slug*",       "destination": "/api/events-router?slug=:slug*" },
    { "source": "/api/portal/:slug*",       "destination": "/api/portal-router?slug=:slug*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
